<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/BattleUI.uss?fileID=7433441132597879392&amp;guid=14326483f516c1349837a34bf938cc71&amp;type=3#BattleUI"/>
    <ui:VisualElement style="flex-grow: 1; width: 918px; margin-top: 125px; background-image: none;">
        <ui:Button text="Move" name="Move" style="height: 41px; width: 178px;"/>
        <ui:Button text="Attack" data-source-path="" name="Attack" style="-unity-text-align: upper-center; white-space: pre; background-position-x: left 0; background-position-y: bottom 0; height: 38px; width: 178px; -unity-text-auto-size: none;"/>
        <ui:Button text="Skills" name="Skills" style="height: 41px; width: 177px;"/>
        <ui:Button text="End Turn" name="EndTurnBtn" style="height: 36px; width: 178px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="TurnOrderContainer" style="flex-grow: 1; position: absolute; bottom: 20px; top: auto; left: auto; right: auto; flex-direction: row; align-items: center; justify-content: center; width: 100%; background-image: none;"/>
    <ui:VisualElement name="SkillPanel" style="flex-grow: 1; position: absolute; height: auto; width: 250px; top: 187px; left: 178px; display: none; background-image: none;"/>
    <ui:VisualElement name="StatsPanel" style="flex-grow: 1; align-items: flex-end; position: absolute; right: 10px; top: 130px; width: 200px; background-color: rgba(0, 0, 0, 0); -unity-text-align: upper-left; font-size: 20px; background-image: url(&quot;project://database/Assets/Material/Materials/Button-removebg-preview.png?fileID=2800000&amp;guid=f0719b3a4b8c4b24ea6bdd54232965d7&amp;type=3#Button-removebg-preview&quot;); background-size: 125% 125%; -unity-font-style: bold; color: rgb(255, 228, 225);">
        <ui:Label text="Label" name="StatsName" style="margin-top: 35px;"/>
        <ui:Label text="Label" name="StatsHP"/>
        <ui:Label text="Label" name="StatsATK"/>
        <ui:Label text="Label" name="StatsRange"/>
        <ui:Label text="Label" name="StatsSpeed"/>
        <ui:Label text="Label" name="StatsMovement" style="margin-bottom: 35px;"/>
    </ui:VisualElement>
</ui:UXML>
